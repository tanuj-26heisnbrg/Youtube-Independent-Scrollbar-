{
  "manifest_version": 3,
  "name": "YouTube Independent Scroll",
  "version": "1.0.0",
  "description": "Scroll YouTube recommendations independently from the video page.",
  "permissions": ["storage"],
  "action": {
    "default_title": "YouTube Independent Scroll",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
