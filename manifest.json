{
  "manifest_version": 3,
  "name": "YouTube Independent Scroll",
  "version": "1.0.0",
  "description": "Scroll YouTube recommendations independently from the video page.",
  "permissions": ["storage"],
  "icons": {
    "16": "asset/icon16.png",
    "32": "asset/icon32.png",
    "48": "asset/icon48.png",
    "128": "asset/icon128.png"
  },
  "action": {
    "default_title": "YouTube Independent Scroll",
    "default_icon": {
      "16": "asset/icon16.png",
      "32": "asset/icon32.png",
      "48": "asset/icon48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
